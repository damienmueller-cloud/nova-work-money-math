---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { auHub, resolveFeatured, allHubLinks } from '../../data/audiences';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const withBase = (path: string) => {
  const clean = path.replace(/^\/+/, '');
  return clean ? `${base}${clean}` : base;
};

const featured = resolveFeatured(auHub.featuredSlugs);
const otherHubs = allHubLinks().filter((h) => h.href !== auHub.path);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: auHub.seoTitle,
  description: auHub.seoDescription,
  url: new URL(withBase(auHub.path.replace(/^\//, '')).replace(/^\/+/, ''), Astro.site).toString(),
  about: 'Freelance calculators for Australia',
};
---

<BaseLayout
  title={`${auHub.seoTitle} — Work & Money Math`}
  description={auHub.seoDescription}
  canonicalPath={auHub.path}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="badge-row">
      <span class="badge">Australia</span>
      <span class="badge">{featured.length} tools</span>
      <span class="badge">GST helper · 10%</span>
    </div>
    <h1>{auHub.headline}</h1>
    <p>{auHub.description}</p>
  </section>

  <section class="category-block" aria-labelledby="au-calcs">
    <h2 id="au-calcs">AU-friendly starting set</h2>
    <div class="card-grid">
      {
        featured.map((calc) => (
          <a class="card" href={`${base}c/${calc.slug}`}>
            <h3>{calc.title}</h3>
            <p>{calc.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <aside class="panel" style="margin-top: 1.25rem">
    <h2>More audiences</h2>
    <ul>
      {
        otherHubs.map((h) => (
          <li>
            <a href={withBase(h.href.replace(/^\//, ''))}>{h.label}</a> — {h.blurb}
          </li>
        ))
      }
      <li>
        <a href={withBase('')}>Full calculator hub</a>
      </li>
    </ul>
    <p class="lede" style="margin-top: 0.75rem">
      GST and take-home tools are <strong>illustrative estimates, not tax or legal advice</strong>. Rules differ
      by situation — check with a qualified professional for decisions that matter.
    </p>
  </aside>
</BaseLayout>
