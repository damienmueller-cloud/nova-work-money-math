---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allHubLinks, calculatorCount } from '../../data/audiences';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const withBase = (path: string) => {
  const clean = path.replace(/^\/+/, '');
  return clean ? `${base}${clean}` : base;
};

const hubs = allHubLinks();
---

<BaseLayout
  title="Browse by audience — Work & Money Math"
  description="Jump to freelance, side-hustle, consultant, or Australia-oriented calculator hubs. Free, client-side tools."
  canonicalPath="/for"
>
  <section class="hero">
    <div class="badge-row">
      <span class="badge">Audience hubs</span>
      <span class="badge">{calculatorCount} calculators on site</span>
    </div>
    <h1>Browse by who you are</h1>
    <p>
      Same free calculators, curated for how you work. Each hub links into the live tools — no duplicate math,
      no accounts.
    </p>
  </section>

  <div class="card-grid">
    {
      hubs.map((hub) => (
        <a class="card" href={withBase(hub.href.replace(/^\//, ''))}>
          <h3>{hub.label}</h3>
          <p>{hub.blurb}</p>
        </a>
      ))
    }
  </div>

  <p class="panel" style="margin-top: 1.5rem">
    Prefer the full catalogue? <a href={withBase('')}>See all calculators</a>.
  </p>
</BaseLayout>
