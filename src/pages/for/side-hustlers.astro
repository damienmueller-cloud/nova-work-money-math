---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { audienceHubs, resolveFeatured, allHubLinks } from '../../data/audiences';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const withBase = (path: string) => {
  const clean = path.replace(/^\/+/, '');
  return clean ? `${base}${clean}` : base;
};

const hub = audienceHubs.find((h) => h.slug === 'side-hustlers')!;
const featured = resolveFeatured(hub.featuredSlugs);
const otherHubs = allHubLinks().filter((h) => h.href !== hub.path);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: hub.seoTitle,
  description: hub.seoDescription,
  url: new URL(withBase(hub.path.replace(/^\/+/, '')).replace(/^\/+/, ''), Astro.site).toString(),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Work & Money Math',
  },
};
---

<BaseLayout
  title={`${hub.seoTitle} — Work & Money Math`}
  description={hub.seoDescription}
  canonicalPath={hub.path}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="badge-row">
      <span class="badge">{hub.title}</span>
      <span class="badge">{featured.length} tools</span>
      <span class="badge">Free · client-side</span>
    </div>
    <h1>{hub.headline}</h1>
    <p>{hub.description}</p>
  </section>

  <section class="category-block" aria-labelledby="featured-calcs">
    <h2 id="featured-calcs">Start here</h2>
    <div class="card-grid">
      {
        featured.map((calc) => (
          <a class="card" href={`${base}c/${calc.slug}`}>
            <h3>{calc.title}</h3>
            <p>{calc.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <aside class="panel" style="margin-top: 1.25rem">
    <h2>Also browse</h2>
    <ul>
      {
        otherHubs.map((h) => (
          <li>
            <a href={withBase(h.href.replace(/^\/+/, ''))}>{h.label}</a> — {h.blurb}
          </li>
        ))
      }
      <li>
        <a href={withBase('')}>All calculators</a> on the home hub
      </li>
    </ul>
    <p class="lede" style="margin-top: 0.75rem">
      Tax and take-home toys are <strong>illustrative estimates, not advice</strong>.
    </p>
  </aside>
</BaseLayout>
