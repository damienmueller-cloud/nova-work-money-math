---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorWidget from '../../components/CalculatorWidget.astro';
import { calculators, getCalculator, getRelated } from '../../data/calculators';

export function getStaticPaths() {
  return calculators.map((calc) => ({
    params: { slug: calc.slug },
  }));
}

const { slug } = Astro.params;
const calculator = getCalculator(slug!);

if (!calculator) {
  return Astro.redirect('/404');
}

const related = getRelated(calculator);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: calculator.title,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: calculator.seoDescription,
  url: new URL(`${import.meta.env.BASE_URL}c/${calculator.slug}`, Astro.site).toString(),
};
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`${calculator.seoTitle} | Work & Money Math`}
  description={calculator.seoDescription}
  canonicalPath={`/c/${calculator.slug}`}
  jsonLd={jsonLd}
>
  <div class="calc-layout">
    <section class="panel">
      <h1>{calculator.title}</h1>
      <p class="lede">{calculator.description}</p>
      <CalculatorWidget calculator={calculator} />
    </section>

    <aside class="panel">
      <h2>How it works</h2>
      <div class="explainer">
        <p>{calculator.explainer}</p>
      </div>

      {
        related.length > 0 && (
          <div class="related">
            <h2>Related calculators</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={`${base}c/${r.slug}`}>
                    {r.title}
                    <span>{r.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
</BaseLayout>
